# Resend — formulaire de contact et newsletter
RESEND_API_KEY=
RESEND_FROM_EMAIL="Yanis Harrat <contact@yanis-harrat.com>"
CONTACT_TO_EMAIL=contact@yanis-harrat.com
RESEND_CONTACT_OWNER_TEMPLATE_ID=
RESEND_CONTACT_RECEIPT_TEMPLATE_ID=
RESEND_NEWSLETTER_CONFIRMATION_TEMPLATE_ID=
RESEND_WATCH_DIGEST_TEMPLATE_ID=
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=

# Liens publics
NEXT_PUBLIC_CALCOM_URL=https://cal.com/yanis-harrat
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile — vraies clés requises en production.
# En local, l'application utilise automatiquement les clés de test officielles Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Réservé aux tests automatisés construits en mode production. Ne jamais activer en production.
TURNSTILE_TEST_MODE=
